// secrets.h.example — sablona pro skutecny secrets.h
//
// Pouziti:
//   1. cp include/secrets.h.example include/secrets.h
//   2. uprav hodnoty nize na sve realne
//   3. include/secrets.h je v .gitignore, neverzuje se
//   4. soubor se zkompiluje primo do binarky pres preprocessor

#pragma once

// WiFi pristupove udaje
#define WIFI_SSID  "your-wifi-name"
#define WIFI_PASS  "your-wifi-password"

// ntfy.sh topic (zvol nahodny string aby byl tezko uhadnutelny)
// Notifikace si pak prihlasis pres ntfy.sh appku nebo browser na
// https://ntfy.sh/<topic>
#define NTFY_TOPIC "your-unique-topic-name"
